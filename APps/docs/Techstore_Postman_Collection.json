          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_code\": \"PRD-002\",\n  \"name\": \"USB-C Charger\",\n  \"description\": \"Fast charger 45W\",\n  \"price\": 29.99,\n  \"stock_quantity\": 100,\n  \"category\": \"Chargers\",\n  \"admin_id\": 1,\n  \"brand_id\": 3\n}"
        },
        "url": { "raw": "{{base_url}}/products", "host": ["{{base_url}}"], "path": ["products"] }
      }
    },
    {
      "name": "Products - Update (protected)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{ \"name\": \"USB-C Charger (Updated)\" }" },
        "url": { "raw": "{{base_url}}/products/{{product_id}}", "host": ["{{base_url}}"], "path": ["products","{{product_id}}"] }
      }
    },
    {
      "name": "Products - Delete (protected)",
      "request": {
        "method": "DELETE",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{base_url}}/products/{{product_id}}", "host": ["{{base_url}}"], "path": ["products","{{product_id}}"] }
      }
    },

    {
