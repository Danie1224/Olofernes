        "body": { "mode": "raw", "raw": "{\n  \"customer_id\": \"CUST-1001\",\n  \"product_id\": 2,\n  \"quantity\": 1\n}" },
        "url": { "raw": "{{base_url}}/add-to-cart", "host": ["{{base_url}}"], "path": ["add-to-cart"] }
