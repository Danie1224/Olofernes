        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"customer_id\": \"CUST-1001\",\n  \"name\": \"Alice Example\",\n  \"email\": \"alice@example.test\",\n  \"phone\": \"555-0101\",\n  \"address\": \"123 Main St\",\n  \"city\": \"Metropolis\",\n  \"state\": \"State\",\n  \"zip_code\": \"12345\",\n  \"country\": \"Country\",\n  \"date_of_birth\": \"1990-01-01\",\n  \"gender\": \"female\",\n  \"status\": \"active\"\n}" },
        "url": { "raw": "{{base_url}}/customers", "host": ["{{base_url}}"], "path": ["customers"] }
      }
    },

