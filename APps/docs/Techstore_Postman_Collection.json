    {
      "name": "Order Completion - Mark as Completed (Admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" },
          { "key": "X-CSRF-TOKEN", "value": "{{csrf_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": { "raw": "{{base_url}}/orders/{{order_id}}/complete", "host": ["{{base_url}}"], "path": ["orders", "{{order_id}}", "complete"] },
        "description": "Mark an order as completed. Requires admin authentication. Records completed_at timestamp and admin_id."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 (successful completion)\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has success flag\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.equal(true);",
              "});",
              "",
              "pm.test(\"Order status is completed\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.order.status).to.equal('completed');",
              "});",
              "",
              "pm.test(\"Completion timestamp is recorded\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.order.completed_at).to.exist;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Order Completion - Get Status",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Accept", "value": "application/json" }
        ],
        "url": { "raw": "{{base_url}}/orders/{{order_id}}/completion-status", "host": ["{{base_url}}"], "path": ["orders", "{{order_id}}", "completion-status"] },
        "description": "Get the completion status and details for an order. Shows completed_at, admin_id, and admin info."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has completion details\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.completion_details).to.exist;",
              "    pm.expect(jsonData.is_completed).to.be.a('boolean');",
              "});"
            ]
          }
        }
      ]
    }
