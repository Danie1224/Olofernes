{
  "info": {
    "_postman_id": "techstore-local-collection",
    "name": "Techstore API (Local)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "# Techstore API Collection\n\nThis collection contains all endpoints for the Techstore API with example requests, responses, and automated tests.\n\n## Setup\n1. Import the environment file\n2. Set base_url to http://127.0.0.1:8000/api/techstore\n3. Start with Auth/Register or Auth/Login to get a token\n4. Tests will automatically save the token\n\n## Testing Flow\n1. Register/Login\n2. Create Customer\n3. Create Product\n4. Add to Cart\n5. Create Order\n6. Add Order Items\n7. Create Shipping"
  },
  "item": [
    {
      "name": "Root",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": ["{{base_url}}"],
          "path": ["/"]
        }
      }
    },
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Alice Example\",\n  \"email\": \"alice+api@example.test\",\n  \"password\": \"secret123\",\n  \"password_confirmation\": \"secret123\"\n}" },
        "url": { "raw": "{{base_url}}/register", "host": ["{{base_url}}"], "path": ["register"] }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice+api@example.test\",\n  \"password\": \"secret123\"\n}" },
        "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
      },
      "response": [
        {
          "name": "Success Response",
          "originalRequest": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice+api@example.test\",\n  \"password\": \"secret123\"\n}" },
            "url": { "raw": "{{base_url}}/login" }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [ { "key": "Content-Type", "value": "application/json" } ],
          "cookie": [],
          "body": "{\n    \"user\": {\n        \"id\": 1,\n        \"name\": \"Alice Example\",\n        \"email\": \"alice+api@example.test\",\n        \"created_at\": \"2025-10-29T00:00:00.000000Z\",\n        \"updated_at\": \"2025-10-29T00:00:00.000000Z\"\n    },\n    \"token\": \"1|laravel_sanctum_token...\"\n}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has token\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.token).to.be.a('string');",
              "    pm.environment.set(\"token\", jsonData.token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Get User (protected)",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{base_url}}/user", "host": ["{{base_url}}"], "path": ["user"] }
      }
    },
    {
      "name": "Auth - Logout (protected)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "{{base_url}}/logout", "host": ["{{base_url}}"], "path": ["logout"] }
      }
    },
    {
